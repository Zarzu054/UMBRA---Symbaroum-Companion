generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  player
  gm
  superadmin
}

enum CampaignMemberRole {
  gm
  player
}

enum CampaignSessionStatus {
  planned
  completed
  cancelled
}

enum CampaignChatVisibility {
  all
  gm_only
}

enum CampaignChatMessageType {
  text
  action
}

model User {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String             @unique
  passwordHash        String             @map("password_hash")
  role                UserRole           @default(player)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  characters          Character[]
  refreshTokens       RefreshToken[]
  gmCampaigns         Campaign[]         @relation("CampaignGm")
  campaignMemberships CampaignMember[]
  campaignXpGrants    CampaignXpLog[]    @relation("CampaignXpGrantUser")
  campaignChatMessages CampaignChatMessage[]

  @@map("users")
}

model Character {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String              @map("owner_id") @db.Uuid
  name              String
  archetype         String
  race              String
  culture           String              @default("")
  profession        String              @default("")
  level             Int
  sheet             Json                @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner             User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  campaignLinks     CampaignCharacter[]
  campaignXpEntries CampaignXpLog[]
  campaignChatEntries CampaignChatMessage[]

  @@map("characters")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Campaign {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gmId         String              @map("gm_id") @db.Uuid
  name         String
  summary      String              @default("")
  setting      String              @default("")
  notes        String              @default("")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  gm           User                @relation("CampaignGm", fields: [gmId], references: [id], onDelete: Cascade)
  members      CampaignMember[]
  characters   CampaignCharacter[]
  npcs         CampaignNpc[]
  experienceLog CampaignXpLog[]
  sessions     CampaignSession[]
  references   CampaignReference[]
  chatMessages CampaignChatMessage[]

  @@index([gmId])
  @@map("campaigns")
}

model CampaignMember {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String             @map("campaign_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  role       CampaignMemberRole @default(player)
  joinedAt   DateTime           @default(now()) @map("joined_at") @db.Timestamptz(6)
  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

model CampaignCharacter {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([campaignId, characterId])
  @@index([characterId])
  @@map("campaign_characters")
}

model CampaignNpc {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  name       String
  race       String   @default("")
  archetype  String   @default("")
  occupation String   @default("")
  threat     String   @default("")
  summary    String   @default("")
  notes      String   @default("")
  statBlock  String   @default("") @map("stat_block")
  sheet      Json?
  isGenerated Boolean @default(false) @map("is_generated")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_npcs")
}

model CampaignChatMessage {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String                  @map("campaign_id") @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  characterId  String?                 @map("character_id") @db.Uuid
  visibility   CampaignChatVisibility  @default(all)
  messageType  CampaignChatMessageType @default(text) @map("message_type")
  text         String                  @default("")
  actionId     String?                 @map("action_id")
  actionLabel  String?                 @map("action_label")
  actionCost   String?                 @map("action_cost")
  actionSummary String?                @map("action_summary")
  rolls        Json                    @default("[]")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  character    Character?              @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([userId])
  @@index([characterId])
  @@map("campaign_chat_messages")
}

model CampaignXpLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  sessionId   String?   @map("session_id") @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  amount      Int
  reason      String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session     CampaignSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  grantedBy   User      @relation("CampaignXpGrantUser", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([sessionId])
  @@index([characterId])
  @@index([grantedById])
  @@map("campaign_xp_log")
}

model CampaignSession {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String                @map("campaign_id") @db.Uuid
  title        String
  scheduledFor DateTime              @map("scheduled_for") @db.Timestamptz(6)
  location     String                @default("")
  summary      String                @default("")
  publicNotes  String                @default("") @map("public_notes")
  dmNotes      String                @default("") @map("dm_notes")
  status       CampaignSessionStatus @default(planned)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  xpLog        CampaignXpLog[]

  @@index([campaignId])
  @@index([scheduledFor])
  @@map("campaign_sessions")
}

model CampaignReference {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  name       String
  label      String
  aliases    Json     @default("[]")
  summary    String   @default("")
  content    String   @default("")
  isPublic   Boolean  @default(false) @map("is_public")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([name])
  @@map("campaign_references")
}
