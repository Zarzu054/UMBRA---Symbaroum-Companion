FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json ./
COPY packages/shared/package.json packages/shared/package-lock.json ./packages/shared/
COPY apps/api/package.json apps/api/package-lock.json ./apps/api/
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/

RUN npm install --prefix packages/shared \
  && npm install --prefix apps/api \
  && npm install --prefix apps/web

COPY . .

RUN npm run build --prefix packages/shared \
  && npm run build --prefix apps/web \
  && npm run prisma:generate --prefix apps/api \
  && chmod +x scripts/docker-entrypoint.prod.sh

EXPOSE 4000

CMD ["./scripts/docker-entrypoint.prod.sh"]
