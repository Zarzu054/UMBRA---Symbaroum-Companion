{
  "name": "@umbra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon -L --config nodemon.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy:raw": "prisma migrate deploy",
    "prisma:migrate:deploy": "node scripts/migrate-deploy-safe.mjs",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "superadmin:create": "tsx scripts/create-superadmin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^6.3.1",
    "@umbra/shared": "file:../../packages/shared",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "umbra-symbaroum-companion": "file:../..",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
