{
  "manifest_version": 3,
  "name": "UMBRA20",
  "version": "0.1.0",
  "description": "Bridge minimal entre UMBRA y el chat de Roll20.",
  "icons": {
    "128": "UMBRA_Roll20_Icon_128x128.png"
  },
  "permissions": ["tabs"],
  "host_permissions": [
    "https://umbra.z4rzu.com/*",
    "https://app.roll20.net/*",
    "https://roll20.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://umbra.z4rzu.com/*"
      ],
      "js": ["umbra-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/editor",
        "https://app.roll20.net/editor/",
        "https://app.roll20.net/editor/*",
        "https://roll20.net/editor",
        "https://roll20.net/editor/",
        "https://roll20.net/editor/*"
      ],
      "js": ["roll20-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
