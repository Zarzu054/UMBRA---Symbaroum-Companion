POSTGRES_DB=umbra
POSTGRES_USER=umbra
POSTGRES_PASSWORD=replace-with-strong-db-password
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=https://umbra.z4rzu.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MVP_SEED_PASSWORD=UmbraStart123!
RESET_SEEDED_PASSWORDS=false
RUN_SEED_ON_START=true

# Optional PostgreSQL backup settings.
# Use a path outside the laptop internal disk when possible: mounted USB disk,
# NAS folder, cloud-sync folder, etc.
UMBRA_BACKUP_REMOTE_DIR=
UMBRA_BACKUP_RETENTION_DAYS=30
